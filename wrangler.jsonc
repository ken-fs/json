{
  // Cloudflare Workers 静态站点配置：托管 Next.js 静态导出产物 out/
  // 与 Git 集成的 Workers Builds 配合：push 到 main 后自动 pnpm build 并部署
  "name": "json",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./out/",
    "binding": "ASSETS",
    // worker.js 要对每个请求先执行（做域名规范化跳转），否则静态命中会跳过脚本
    "run_worker_first": true,
    // 目录结构为 dir/index.html，默认 auto-trailing-slash 行为与旧站一致
    // 未匹配路径返回 404 状态并渲染 out/404.html
    "not_found_handling": "404-page"
  }
}
